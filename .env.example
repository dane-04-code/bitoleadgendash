NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, and REQUIRED against the live database. Row-level security is
# enabled deny-by-default on every table, so the anon key above reads nothing;
# this key bypasses RLS and is what the app actually connects with.
# It must NEVER be prefixed NEXT_PUBLIC_ or reach the browser. Consumed only by
# src/lib/supabase/server.ts. See context/ARCHITECTURE.md section 5.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

DASHBOARD_PASSWORD=changeme
DASHBOARD_SESSION_SECRET=change-this-to-a-long-random-string
# Shared code reps must enter to self-register at /signup.
# Leave unset to close sign-ups entirely.
REP_SIGNUP_CODE=BITO2026
